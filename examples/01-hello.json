{
  "version": "1",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "주문 정보",
      "position": { "x": 80, "y": 160 },
      "config": {
        "inputs": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "고객 이름" },
            "item": { "type": "string", "description": "주문한 상품" },
            "quantity": { "type": "number", "description": "수량" }
          },
          "required": ["name", "item", "quantity"]
        }
      }
    },
    {
      "id": "message",
      "type": "template",
      "label": "확인 문구",
      "position": { "x": 360, "y": 160 },
      "config": {
        "template": "{{ start.name }}님, {{ start.item }} {{ start.quantity }}개 주문을 접수했습니다.",
        "format": "text"
      }
    },
    {
      "id": "end",
      "type": "end",
      "label": "끝",
      "position": { "x": 640, "y": 160 },
      "config": { "outputs": { "confirmation": "{{ message.text }}" } }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "message" },
    { "id": "e2", "source": "message", "target": "end" }
  ]
}
