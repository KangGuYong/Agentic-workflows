{
  "version": "1",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "문의 접수",
      "position": { "x": 80, "y": 260 },
      "config": {
        "inputs": {
          "type": "object",
          "properties": {
            "subject": { "type": "string", "description": "문의 제목" },
            "body": { "type": "string", "description": "문의 본문" }
          },
          "required": ["subject", "body"]
        }
      }
    },
    {
      "id": "triage",
      "type": "classifier",
      "label": "문의 분류",
      "position": { "x": 360, "y": 260 },
      "config": {
        "model": "qwen2.5:14b",
        "input": "제목: {{ start.subject }}\n본문: {{ start.body }}",
        "instructions": "고객 문의를 담당 부서 기준으로 분류합니다. 확실하지 않으면 default를 고르세요.",
        "categories": [
          { "id": "billing", "description": "결제, 환불, 요금제, 세금계산서에 관한 문의" },
          { "id": "technical", "description": "오류, 장애, 사용 방법 등 제품 동작에 관한 문의" },
          { "id": "sales", "description": "도입 상담, 견적, 계약 조건에 관한 문의" }
        ],
        "temperature": 0
      }
    },
    {
      "id": "draft_billing",
      "type": "llm",
      "label": "결제 답변 초안",
      "position": { "x": 680, "y": 60 },
      "config": {
        "model": "qwen2.5:14b",
        "system": "당신은 결제 담당 상담원입니다. 정중한 한국어 존댓말로 답변 초안을 씁니다.",
        "prompt": "다음 문의에 대한 답변 초안을 3문장 이내로 작성하세요.\n\n{{ start.body }}",
        "temperature": 0.3,
        "outputSchema": {
          "type": "object",
          "properties": {
            "reply": { "type": "string", "description": "고객에게 보낼 답변 초안" },
            "needsInvoice": { "type": "boolean", "description": "세금계산서 재발행이 필요한지" }
          },
          "required": ["reply", "needsInvoice"]
        }
      }
    },
    {
      "id": "draft_technical",
      "type": "llm",
      "label": "기술 답변 초안",
      "position": { "x": 680, "y": 260 },
      "config": {
        "model": "qwen2.5:14b",
        "system": "당신은 기술 지원 담당자입니다. 재현 절차를 먼저 확인하는 답변을 씁니다.",
        "prompt": "다음 문의에 대한 답변 초안을 3문장 이내로 작성하세요.\n\n{{ start.body }}",
        "temperature": 0.3
      }
    },
    {
      "id": "route_sales",
      "type": "template",
      "label": "영업 이관",
      "position": { "x": 680, "y": 460 },
      "config": {
        "template": "영업팀 이관: {{ start.subject }}",
        "format": "text"
      }
    },
    {
      "id": "route_unknown",
      "type": "template",
      "label": "분류 실패",
      "position": { "x": 680, "y": 620 },
      "config": {
        "template": "수동 확인 필요: {{ start.subject }}",
        "format": "text"
      }
    },
    {
      "id": "end",
      "type": "end",
      "label": "끝",
      "position": { "x": 1000, "y": 260 },
      "config": {
        "outputs": {
          "category": "{{ triage.category }}",
          "draft": "{{ draft_billing.reply | default('', true) }}{{ draft_technical.text | default('', true) }}{{ route_sales.text | default('', true) }}{{ route_unknown.text | default('', true) }}"
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "triage" },
    { "id": "e2", "source": "triage", "sourceHandle": "billing", "target": "draft_billing" },
    { "id": "e3", "source": "triage", "sourceHandle": "technical", "target": "draft_technical" },
    { "id": "e4", "source": "triage", "sourceHandle": "sales", "target": "route_sales" },
    { "id": "e5", "source": "triage", "sourceHandle": "default", "target": "route_unknown" },
    { "id": "e6", "source": "draft_billing", "target": "end" },
    { "id": "e7", "source": "draft_technical", "target": "end" },
    { "id": "e8", "source": "route_sales", "target": "end" },
    { "id": "e9", "source": "route_unknown", "target": "end" }
  ]
}
